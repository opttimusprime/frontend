
pipeline {
    agent any

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '717090908085.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'roboshop/frontend'
        IMAGE_TAG    = "${BUILD_NUMBER}"
    }

    stages {
        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/opttimusprime/frontend.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    echo "Frontend is a static Nginx application"
                    echo "No dependencies to install"
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build --no-cache --pull \
                      -t ${ECR_REPO}:${IMAGE_TAG} .
                """
            }
        }

        stage('Login to ECR') {
            steps {
                sh """#!/bin/bash
                    set -e
                    set -o pipefail

                    aws ecr get-login-password \
                      --region ${AWS_REGION} | \
                    docker login \
                      --username AWS \
                      --password-stdin ${ECR_REGISTRY}
                """
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh """
                    docker tag \
                      ${ECR_REPO}:${IMAGE_TAG} \
                      ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}

                    docker tag \
                      ${ECR_REPO}:${IMAGE_TAG} \
                      ${ECR_REGISTRY}/${ECR_REPO}:latest
                """
            }
        }

        stage('Push Docker Image') {
            steps {
                sh """
                    docker push \
                      ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}

                    docker push \
                      ${ECR_REGISTRY}/${ECR_REPO}:latest
                """
            }
        }
    }

    post {
        always {
            echo 'Frontend CI Pipeline execution completed.'
        }

        success {
            echo 'Frontend CI completed successfully'
            echo "Image pushed: ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"

            build job: 'rs-frontend-cd',
                parameters: [
                    string(
                        name: 'IMAGE_TAG',
                        value: "${env.IMAGE_TAG}"
                    )
                ],
                wait: false
        }

        failure {
            echo 'Frontend CI failed'
        }
    }
}
