
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'ECR image tag to deploy'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        ECR_REGISTRY = '717090908085.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO = 'roboshop/nginx'

        K8S_NAMESPACE = 'ns-nginx'
        HELM_RELEASE = 'frontend'
        HELM_CHART = './helm'

        MINIKUBE_HOST = '10.10.1.224'
        MINIKUBE_USER = 'ec2-user'

        // IMAGE_DIGEST = ''
    }

    stages {
        stage('Validate Inputs') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('ERROR: IMAGE_TAG is required')
                    }
                }
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/opttimusprime/frontend.git'
            }
        }

        stage('Get Image Digest') {
            steps {
                script {
                    def digest = sh(
                script: """
                    aws ecr describe-images \
                      --repository-name ${env.ECR_REPO} \
                      --image-ids imageTag=${params.IMAGE_TAG} \
                      --region ${env.AWS_REGION} \
                      --query 'imageDetails[0].imageDigest' \
                      --output text
                """,
                returnStdout: true
            ).trim()

                    echo "Image Tag: [${params.IMAGE_TAG}]"
                    echo "Image Digest: [${digest}]"
                    echo "Digest Length: ${digest.length()}"

                    if (!(digest ==~ /^sha256:[a-fA-F0-9]{64}$/)) {
                        error("ERROR: Invalid or missing image digest for tag: ${params.IMAGE_TAG}")
                    }

                    env.IMAGE_DIGEST = digest
                    echo "Stored IMAGE_DIGEST: [${env.IMAGE_DIGEST}]"

                    echo 'SUCCESS: ECR image digest verified.'
                }
            }
        }

        stage('Refresh ECR Secret') {
            steps {
                sshagent(['jenkins-minikube-ssh']) {
                    sh '''
                ssh -o BatchMode=yes \
                    -o StrictHostKeyChecking=yes \
                    ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                    'aws ecr get-login-password --region us-east-1 |
                     kubectl create secret docker-registry ecr-registry-secret \
                       --namespace ns-nginx \
                       --docker-server=717090908085.dkr.ecr.us-east-1.amazonaws.com \
                       --docker-username=AWS \
                       --docker-password="$(cat)" \
                       --dry-run=client -o yaml |
                     kubectl apply -f -'
            '''
                }
            }
        }

        stage('Transfer Helm Chart') {
            steps {
                sshagent(['jenkins-minikube-ssh']) {
                    sh '''
                        tar -czf /tmp/frontend-helm.tar.gz -C helm .

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "mkdir -p /home/ec2-user/frontend-helm"

                        scp -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            /tmp/frontend-helm.tar.gz \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST}:/tmp/frontend-helm.tar.gz

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "tar -xzf /tmp/frontend-helm.tar.gz -C /home/ec2-user/frontend-helm"
                    '''
                }
            }
        }

        stage('Deploy to Minikube') {
            steps {
                script {
                    def digest = env.IMAGE_DIGEST?.trim()

                    if (!(digest ==~ /^sha256:[a-fA-F0-9]{64}$/)) {
                        error('ERROR: IMAGE_DIGEST is missing or invalid before Helm deployment')
                    }

                    echo "Deploying image digest: ${digest}"

                    sshagent(['jenkins-minikube-ssh']) {
                        sh """
                    ssh -o BatchMode=yes \\
                        -o StrictHostKeyChecking=yes \\
                        ${env.MINIKUBE_USER}@${env.MINIKUBE_HOST} \\
                        'helm upgrade --install ${env.HELM_RELEASE} /home/ec2-user/frontend-helm \\
                          --namespace ${env.K8S_NAMESPACE} \\
                          --set-string image.repository=${env.ECR_REGISTRY}/${env.ECR_REPO} \\
                          --set-string image.digest=${digest} \\
                          --wait \\
                          --timeout 5m'
                """
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sshagent(['jenkins-minikube-ssh']) {
                    sh '''
                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "kubectl rollout status deployment/${HELM_RELEASE} -n ${K8S_NAMESPACE} --timeout=180s &&
                             kubectl get pods -n ${K8S_NAMESPACE} &&
                             kubectl get svc -n ${K8S_NAMESPACE} &&
                             kubectl get ingress -n ${K8S_NAMESPACE} &&
                             kubectl get deployment ${HELM_RELEASE} -n ${K8S_NAMESPACE} -o jsonpath='{.spec.template.spec.containers[0].image}' &&
                             echo"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend deployment completed successfully.'
            echo "Image Digest: ${env.IMAGE_DIGEST}"
        }

        failure {
            echo 'Frontend deployment failed.'
        }
    }
}

