
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'ECR image tag to deploy'
        )
    }

    environment {
        AWS_REGION   = 'us-east-1'
        EKS_CLUSTER  = 'roboshop-dev-eks'

        ECR_REGISTRY = '717090908085.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'roboshop/frontend'

        K8S_NAMESPACE = 'frontend'
        HELM_RELEASE  = 'frontend'
        HELM_CHART    = './helm'
    }

    stages {
        stage('Validate Inputs') {
            steps {
                script {
                    if (!(params.IMAGE_TAG ==~ /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$/)) {
                        error('ERROR: Valid IMAGE_TAG is required')
                    }
                }
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/opttimusprime/frontend.git'
            }
        }

        stage('Get Image Digest') {
            steps {
                script {
                    def digest = sh(
                        script: '''
                            aws ecr describe-images \
                              --repository-name "$ECR_REPO" \
                              --image-ids "imageTag=$IMAGE_TAG" \
                              --region "$AWS_REGION" \
                              --query 'imageDetails[0].imageDigest' \
                              --output text
                        '''.replace('$IMAGE_TAG', params.IMAGE_TAG),
                        returnStdout: true
                    ).trim()

                    if (!(digest ==~ /^sha256:[a-fA-F0-9]{64}$/)) {
                        error("ERROR: Invalid image digest for tag: ${params.IMAGE_TAG}")
                    }

                    env.IMAGE_DIGEST = digest

                    echo "Image Tag: ${params.IMAGE_TAG}"
                    echo "Image Digest: ${env.IMAGE_DIGEST}"
                }
            }
        }

        stage('Configure EKS Access') {
            steps {
                sh '''
                    set -e

                    aws eks update-kubeconfig \
                      --region "$AWS_REGION" \
                      --name "$EKS_CLUSTER"

                    kubectl config current-context

                    kubectl get nodes
                '''
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh '''
                    set -e

                    helm upgrade --install "$HELM_RELEASE" "$HELM_CHART" \
                      --namespace "$K8S_NAMESPACE" \
                      --create-namespace \
                      --set-string "image.digest=$IMAGE_DIGEST" \
                      --wait \
                      --timeout 5m
                '''
            }
        }

        stage('Verify Deployment') {
            steps {
                sh '''
                    set -e

                    kubectl rollout status \
                      deployment/"$HELM_RELEASE" \
                      -n "$K8S_NAMESPACE" \
                      --timeout=180s

                    kubectl get deployments -n "$K8S_NAMESPACE"

                    kubectl get pods -n "$K8S_NAMESPACE" -o wide

                    kubectl get svc -n "$K8S_NAMESPACE"

                    kubectl get ingress -n "$K8S_NAMESPACE"

                    DEPLOYED_IMAGE=$(kubectl get deployment "$HELM_RELEASE" \
                      -n "$K8S_NAMESPACE" \
                      -o jsonpath='{.spec.template.spec.containers[0].image}')

                    EXPECTED_IMAGE="${ECR_REGISTRY}/${ECR_REPO}@${IMAGE_DIGEST}"

                    echo "Expected image: $EXPECTED_IMAGE"
                    echo "Deployed image: $DEPLOYED_IMAGE"

                    if [ "$DEPLOYED_IMAGE" != "$EXPECTED_IMAGE" ]; then
                        echo "ERROR: Deployed image does not match expected digest"
                        exit 1
                    fi

                    echo "SUCCESS: Frontend deployment verified"
                '''
            }
        }
    }

    post {
        success {
            echo 'Frontend CD completed successfully.'
            echo "Image Digest: ${env.IMAGE_DIGEST}"
        }

        failure {
            echo 'Frontend CD failed.'
        }
    }
}
