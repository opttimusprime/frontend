
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Previous working ECR image tag to rollback to'
        )
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '717090908085.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'roboshop/nginx'

        K8S_NAMESPACE = 'ns-nginx'
        HELM_RELEASE  = 'frontend'
        HELM_CHART    = './helm'

        MINIKUBE_HOST = '10.10.1.224'
        MINIKUBE_USER = 'ec2-user'
    }

    stages {

        stage('Validate Inputs') {
            steps {
                script {
                    if (!params.IMAGE_TAG?.trim()) {
                        error('ERROR: IMAGE_TAG is required')
                    }

                    if (!(params.IMAGE_TAG ==~ /^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$/)) {
                        error('ERROR: Invalid IMAGE_TAG format')
                    }

                    echo "Rollback Image Tag: ${params.IMAGE_TAG}"
                }
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/opttimusprime/frontend.git'
            }
        }

        stage('Get Image Digest') {
            steps {
                script {
                    def digest = sh(
                        script: """
                            aws ecr describe-images \
                              --repository-name ${env.ECR_REPO} \
                              --image-ids imageTag=${params.IMAGE_TAG} \
                              --region ${env.AWS_REGION} \
                              --query 'imageDetails[0].imageDigest' \
                              --output text
                        """,
                        returnStdout: true
                    ).trim()

                    echo "Rollback Image Tag: [${params.IMAGE_TAG}]"
                    echo "Rollback Image Digest: [${digest}]"
                    echo "Digest Length: ${digest.length()}"

                    if (!(digest ==~ /^sha256:[a-fA-F0-9]{64}$/)) {
                        error("ERROR: Invalid or missing image digest for tag: ${params.IMAGE_TAG}")
                    }

                    env.IMAGE_DIGEST = digest

                    echo 'SUCCESS: Rollback image digest verified.'
                }
            }
        }

        stage('Refresh ECR Secret') {
            steps {
                sshagent(['jenkins-minikube-ssh']) {
                    sh '''
                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            'aws ecr get-login-password --region us-east-1 |
                             kubectl create secret docker-registry ecr-registry-secret \
                               --namespace ns-nginx \
                               --docker-server=717090908085.dkr.ecr.us-east-1.amazonaws.com \
                               --docker-username=AWS \
                               --docker-password="$(cat)" \
                               --dry-run=client -o yaml |
                             kubectl apply -f -'
                    '''
                }
            }
        }

        stage('Transfer Helm Chart') {
            steps {
                sshagent(['jenkins-minikube-ssh']) {
                    sh '''
                        set -e

                        tar -czf /tmp/frontend-rollback-helm.tar.gz -C helm .

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "mkdir -p /home/ec2-user/frontend-helm"

                        scp -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            /tmp/frontend-rollback-helm.tar.gz \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST}:/tmp/frontend-rollback-helm.tar.gz

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "tar -xzf /tmp/frontend-rollback-helm.tar.gz -C /home/ec2-user/frontend-helm"
                    '''
                }
            }
        }

        stage('Rollback Frontend') {
            steps {
                script {
                    def digest = env.IMAGE_DIGEST?.trim()

                    if (!(digest ==~ /^sha256:[a-fA-F0-9]{64}$/)) {
                        error('ERROR: IMAGE_DIGEST is missing or invalid before rollback')
                    }

                    echo "Rolling back to image digest: ${digest}"

                    sshagent(['jenkins-minikube-ssh']) {
                        sh """
                            ssh -o BatchMode=yes \\
                                -o StrictHostKeyChecking=yes \\
                                ${env.MINIKUBE_USER}@${env.MINIKUBE_HOST} \\
                                'helm upgrade --install ${env.HELM_RELEASE} /home/ec2-user/frontend-helm \\
                                  --namespace ${env.K8S_NAMESPACE} \\
                                  --set-string image.repository=${env.ECR_REGISTRY}/${env.ECR_REPO} \\
                                  --set-string image.digest=${digest} \\
                                  --wait \\
                                  --timeout 5m'
                        """
                    }
                }
            }
        }

        stage('Verify Rollback') {
            steps {
                sshagent(['jenkins-minikube-ssh']) {
                    sh '''
                        set -e

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "kubectl rollout status deployment/${HELM_RELEASE} \
                               -n ${K8S_NAMESPACE} --timeout=180s"

                        echo "-----------------------------"
                        echo "Helm Release"
                        echo "-----------------------------"

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "helm list -n ${K8S_NAMESPACE}"

                        echo "-----------------------------"
                        echo "Helm History"
                        echo "-----------------------------"

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "helm history ${HELM_RELEASE} -n ${K8S_NAMESPACE}"

                        echo "-----------------------------"
                        echo "Running Pods"
                        echo "-----------------------------"

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "kubectl get pods -n ${K8S_NAMESPACE} -o wide"

                        echo "-----------------------------"
                        echo "Service and Ingress"
                        echo "-----------------------------"

                        ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "kubectl get svc,ingress -n ${K8S_NAMESPACE}"

                        echo "-----------------------------"
                        echo "Verify Running Image"
                        echo "-----------------------------"

                        RUNNING_IMAGE=$(ssh -o BatchMode=yes \
                            -o StrictHostKeyChecking=yes \
                            ${MINIKUBE_USER}@${MINIKUBE_HOST} \
                            "kubectl get deployment ${HELM_RELEASE} \
                              -n ${K8S_NAMESPACE} \
                              -o jsonpath='{.spec.template.spec.containers[0].image}'")

                        EXPECTED_IMAGE="${ECR_REGISTRY}/${ECR_REPO}@${IMAGE_DIGEST}"

                        echo "Expected Image: ${EXPECTED_IMAGE}"
                        echo "Running Image : ${RUNNING_IMAGE}"

                        if [ "${RUNNING_IMAGE}" != "${EXPECTED_IMAGE}" ]; then
                            echo "ERROR: Rollback image mismatch"
                            exit 1
                        fi

                        echo "SUCCESS: Rollback image verified."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend rollback completed successfully.'
            echo "Rollback Image Tag: ${params.IMAGE_TAG}"
            echo "Rollback Digest: ${env.IMAGE_DIGEST}"
        }

        failure {
            echo 'Frontend rollback failed.'
        }
    }
}






















