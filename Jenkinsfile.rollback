
pipeline {
    agent any

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Previous working ECR image tag to rollback to'
        )
    }

    environment {
        AWS_REGION   = 'us-east-1'
        EKS_CLUSTER  = 'roboshop-dev-eks'

        ECR_REGISTRY = '717090908085.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPO     = 'roboshop/frontend'

        K8S_NAMESPACE = 'frontend'
        HELM_RELEASE  = 'frontend'
        HELM_CHART    = './helm'

        IMAGE_DIGEST = ''
    }

    stages {
        stage('Validate Inputs') {
            steps {
                script {
                    if (!(params.IMAGE_TAG ==~ /^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$/)) {
                        error('ERROR: Valid IMAGE_TAG is required')
                    }

                    env.IMAGE_TAG = params.IMAGE_TAG

                    echo "Rollback Image Tag: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Checkout Code') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/opttimusprime/frontend.git'
            }
        }

        stage('Get Image Digest') {
            steps {
                script {
                    def digest = sh(
                        script: '''
                            set -e

                            aws ecr describe-images \
                              --repository-name "$ECR_REPO" \
                              --image-ids "imageTag=$IMAGE_TAG" \
                              --region "$AWS_REGION" \
                              --query 'imageDetails[0].imageDigest' \
                              --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!(digest ==~ /^sha256:[a-fA-F0-9]{64}$/)) {
                        error("ERROR: Invalid or missing digest for tag: ${params.IMAGE_TAG}")
                    }

                    env.IMAGE_DIGEST = digest

                    echo "Rollback Image Tag: ${env.IMAGE_TAG}"
                    echo "Rollback Image Digest: ${env.IMAGE_DIGEST}"
                    echo 'SUCCESS: Rollback image digest verified.'
                }
            }
        }

        stage('Configure EKS Access') {
            steps {
                sh '''
                    set -e

                    aws eks update-kubeconfig \
                      --region "$AWS_REGION" \
                      --name "$EKS_CLUSTER"

                    kubectl config current-context

                    kubectl get nodes
                '''
            }
        }

        stage('Rollback Frontend') {
            steps {
                sh '''
                    set -e

                    helm status "$HELM_RELEASE" \
                      --namespace "$K8S_NAMESPACE"

                    helm upgrade "$HELM_RELEASE" "$HELM_CHART" \
                      --namespace "$K8S_NAMESPACE" \
                      --set-string "image.digest=$IMAGE_DIGEST" \
                      --atomic \
                      --wait \
                      --timeout 5m
                '''
            }
        }

        stage('Verify Rollback') {
            steps {
                sh '''
                    set -e

                    kubectl rollout status \
                      deployment/"$HELM_RELEASE" \
                      -n "$K8S_NAMESPACE" \
                      --timeout=180s

                    echo "-----------------------------"
                    echo "Helm Release"
                    echo "-----------------------------"

                    helm list -n "$K8S_NAMESPACE"

                    echo "-----------------------------"
                    echo "Helm History"
                    echo "-----------------------------"

                    helm history "$HELM_RELEASE" \
                      -n "$K8S_NAMESPACE"

                    echo "-----------------------------"
                    echo "Running Pods"
                    echo "-----------------------------"

                    kubectl get pods \
                      -n "$K8S_NAMESPACE" -o wide

                    echo "-----------------------------"
                    echo "Service and Ingress"
                    echo "-----------------------------"

                    kubectl get svc,ingress \
                      -n "$K8S_NAMESPACE"

                    echo "-----------------------------"
                    echo "Verify Running Image"
                    echo "-----------------------------"

                    RUNNING_IMAGE=$(kubectl get deployment "$HELM_RELEASE" \
                      -n "$K8S_NAMESPACE" \
                      -o jsonpath='{.spec.template.spec.containers[0].image}')

                    EXPECTED_IMAGE="${ECR_REGISTRY}/${ECR_REPO}@${IMAGE_DIGEST}"

                    echo "Expected Image: $EXPECTED_IMAGE"
                    echo "Running Image : $RUNNING_IMAGE"

                    if [ "$RUNNING_IMAGE" != "$EXPECTED_IMAGE" ]; then
                        echo "ERROR: Rollback image mismatch"
                        exit 1
                    fi

                    echo "SUCCESS: Rollback image verified."
                '''
            }
        }
    }

    post {
        success {
            echo 'Frontend rollback completed successfully.'
            echo "Rollback Image Tag: ${params.IMAGE_TAG}"
            echo "Rollback Digest: ${env.IMAGE_DIGEST}"
        }

        failure {
            echo 'Frontend rollback failed.'
        }
    }
}
